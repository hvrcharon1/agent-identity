{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{"name": "next"}],
    "paths": {
      "@/*": ["./src/*"],
      "@datacules/agent-identity": ["./packages/core/src/index.ts"],
      "@datacules/agent-identity/schemas": ["./packages/core/src/schemas.ts"],
      "@datacules/agent-identity/react": ["./packages/core/src/react/index.ts"],
      "@datacules/agent-identity-anomaly": ["./packages/integrations/anomaly/src/index.ts"],
      "@datacules/agent-identity-store-vault": ["./packages/stores/vault/src/index.ts"],
      "@datacules/agent-identity-store-aws": ["./packages/stores/aws/src/index.ts"],
      "@datacules/agent-identity-store-azure": ["./packages/stores/azure/src/index.ts"]
    }
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "packages"]
}

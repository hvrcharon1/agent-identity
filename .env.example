# .env.example — copy to .env.local and fill in values
# Do NOT commit .env.local — it is gitignored

# ─── Credential Store ──────────────────────────────────────────────────────────
#
# Select which credential store backend to use.
# Options: memory (default) | vault | aws | azure
#
CREDENTIAL_STORE_TYPE=        # memory | vault | aws | azure  (default: memory)

# HashiCorp Vault KV v2
CREDENTIAL_STORE_URL=         # https://vault.example.com  (required when type=vault)
VAULT_TOKEN=                  # hvs.xxxxxxxxxxxxxxxxxxxx    (required when type=vault)
VAULT_MOUNT_PATH=             # KV v2 mount path            (default: secret)
VAULT_PREFIX=                 # path prefix under mount     (default: agent-identity)

# AWS Secrets Manager + DynamoDB migration locks
AWS_REGION=                   # e.g. us-east-1  (optional — uses SDK default chain)
AWS_LOCKS_TABLE=              # DynamoDB table name for migration locks (default: agent-identity-locks)

# Azure Key Vault + Table Storage
AZURE_KEYVAULT_URL=           # https://acme.vault.azure.net          (required when type=azure)
AZURE_TABLES_ENDPOINT=        # https://acme.table.core.windows.net   (required when type=azure)

# ─── Routing Rules ─────────────────────────────────────────────────────────────
#
# When set, routing rules are loaded from this JSON file at startup instead of
# using the DEFAULT_ROUTING_RULES in src/lib/credentials.ts. Allows rule updates
# in Docker / Kubernetes deployments without rebuilding the container image.
#
ROUTING_RULES_PATH=           # /etc/agent-identity/rules.json  (optional)

# ─── Encryption ────────────────────────────────────────────────────────────────
CREDENTIAL_ENCRYPTION_KEY=    # AES-256 key for encrypting credential refs at rest

# ─── Audit Logging ─────────────────────────────────────────────────────────────
AUDIT_LOG_ENDPOINT=           # POST endpoint for AuditLogEntry JSON payloads

# ─── AI Provider Base URLs ─────────────────────────────────────────────────────
OPENAI_API_BASE=https://api.openai.com/v1
ANTHROPIC_API_BASE=https://api.anthropic.com
GEMINI_API_BASE=https://generativelanguage.googleapis.com
MISTRAL_API_BASE=https://api.mistral.ai

# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

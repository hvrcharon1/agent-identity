{
  "name": "@datacules/agent-identity-store-libsql",
  "version": "0.11.0",
  "private": false,
  "description": "LibSQL (SQLite / Turso) credential store for @datacules/agent-identity \u2014 zero server, one npm install, scales to distributed",
  "author": "Datacules LLC <hello@datacules.com>",
  "license": "SEE LICENSE IN LICENSE",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0"
  },
  "peerDependencies": {
    "@datacules/agent-identity": "^0.11.0"
  },
  "devDependencies": {
    "@datacules/agent-identity": "*",
    "typescript": "^5"
  },
  "keywords": ["agent-identity", "sqlite", "libsql", "turso", "credential-store", "ai-agents"]
}

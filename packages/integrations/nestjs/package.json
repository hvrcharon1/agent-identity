{
  "name": "@datacules/agent-identity-nestjs",
  "version": "0.1.0",
  "private": false,
  "description": "NestJS module, guard, and decorator for @datacules/agent-identity",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@datacules/agent-identity": "^0.3.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0"
  },
  "devDependencies": {
    "@datacules/agent-identity": "*",
    "@nestjs/common": "^10",
    "@nestjs/core": "^10",
    "reflect-metadata": "^0.2.0",
    "typescript": "^5"
  },
  "files": [
    "dist",
    "src"
  ]
}

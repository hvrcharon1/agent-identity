{
  "name": "@datacules/agent-identity-langchain",
  "version": "0.1.0",
  "private": false,
  "description": "LangChain and LangGraph adapter for @datacules/agent-identity",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --out-dir dist",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@datacules/agent-identity": "workspace:*"
  },
  "devDependencies": {
    "@langchain/core": "^0.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5",
    "vitest": "^1.6.0"
  },
  "peerDependencies": {
    "@langchain/core": ">=0.2.0"
  },
  "peerDependenciesMeta": {
    "@langchain/core": {
      "optional": false
    }
  }
}

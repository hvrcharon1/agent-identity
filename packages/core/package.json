{
  "name": "@datacules/agent-identity",
  "version": "0.6.0",
  "private": false,
  "description": "Provider-agnostic credential routing and identity management for AI agents",
  "author": "Datacules LLC",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hvrcharon1/agent-identity.git",
    "directory": "packages/core"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    "." : {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./react": {
      "import": "./dist/esm/react/index.js",
      "types": "./dist/types/react/index.d.ts"
    },
    "./schemas": {
      "import": "./dist/esm/schemas.js",
      "require": "./dist/cjs/schemas.js",
      "types": "./dist/types/schemas.d.ts"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json",
    "test": "echo \"Tests run from monorepo root via vitest.config.ts\" && exit 0",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "react": "^18",
    "typescript": "^5"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  }
}

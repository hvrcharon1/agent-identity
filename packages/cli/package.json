{
  "name": "@datacules/agent-identity-cli",
  "version": "0.11.0",
  "description": "CLI for @datacules/agent-identity — audit chain verification, compliance reports, credential resolution testing",
  "private": false,
  "author": "Datacules LLC",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/hvrcharon1/agent-identity.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "agent-identity",
    "cli",
    "audit",
    "compliance",
    "soc2",
    "gdpr",
    "hipaa",
    "ai-agents",
    "datacules"
  ],
  "bin": {
    "agent-identity-cli": "./bin/agent-identity.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "bin",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --treeshake",
    "dev": "tsup src/index.ts --format cjs,esm --watch"
  },
  "dependencies": {
    "@datacules/agent-identity-compliance": "*"
  },
  "devDependencies": {
    "@datacules/agent-identity": "*",
    "@datacules/agent-identity-compliance": "*",
    "tsup": "^8.0.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  }
}
